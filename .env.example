# Required to start ButterBot.
DISCORD_TOKEN=

# Required authorization configuration for retained owner-only commands.
OWNER_ID=

# Explicitly opt into development/admin commands. Only true or false is accepted.
ENABLE_DEV_COMMANDS=false

# Required only when ENABLE_DEV_COMMANDS=true.
DEV_GUILD_ID=

# Before disabling development commands on an existing Discord application,
# remove/sync previously registered guild commands; Discord stores them remotely.

# Relative paths resolve from the current working directory.
DATABASE_PATH=data/butterbot.sqlite3
LOG_LEVEL=INFO

# Required only when the Valorant feature vertical slice is implemented.
VAL_KEY=
