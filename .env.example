# Required to start ButterBot.
DISCORD_TOKEN=

# Required authorization configuration for retained owner-only commands.
OWNER_ID=

# Optional. Retained commands may introduce development-guild scoping later.
DEV_GUILD_ID=

# Relative paths resolve from the current working directory.
DATABASE_PATH=data/butterbot.sqlite3
LOG_LEVEL=INFO

# Required only when the Valorant feature vertical slice is implemented.
VAL_KEY=
